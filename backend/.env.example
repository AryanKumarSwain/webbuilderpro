# Server
PORT=5000
NODE_ENV=development

# Database
# Local dev (XAMPP): DB_HOST=localhost, DB_PORT=3306, no SSL needed.
# Production (Aiven): use the host/port/user/password from your Aiven service
# overview page, e.g. DB_HOST=mysql-xxxxxxxx-xxxxx.b.aivencloud.com, DB_PORT=13494.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_school_saas
DB_PORT=3306

# Aiven requires SSL; local XAMPP MySQL does not support it. This var is the
# opt-in switch: LEAVE IT UNSET for local dev (even though backend/ca.pem is
# committed and present on disk, SSL is only attempted when this is set).
# On Render, set DB_SSL_CA_PATH=ca.pem to point at that committed file.
# DB_SSL_CA_PATH=ca.pem

# JWT — use long random strings in production, never reuse the example values
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary — get these from your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL — must match exactly where the frontend is running/deployed.
# Used both by CORS (app.js) and to build password-reset links.
FRONTEND_URL=http://localhost:5173

# Resend — used to send "forgot password" reset emails, plus the signup
# request / approval emails (backend/src/config/mailer.js). Get an API key at
# resend.com/api-keys. The wbpro.in domain must also be verified in the
# Resend dashboard (DNS records) — without that, Resend only lets you send to
# your own account email, not arbitrary recipients like a new school's signup
# email. (Previously used Gmail SMTP; switched because most PaaS hosts block
# or throttle outbound SMTP.)
RESEND_API_KEY=

# Razorpay — get these from the Razorpay dashboard (dashboard.razorpay.com/app/keys).
# Used by the Billing page (post-approval plan purchase).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret — set the SAME value here and in the Razorpay dashboard
# (Settings -> Webhooks) for the payment.captured webhook -> POST /api/billing/webhook.
# Leave blank to disable the webhook safety net (it just no-ops and logs).
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://www.wbpro.in/api/auth/google/callback

